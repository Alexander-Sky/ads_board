# Скопируйте этот файл в .env и заполните значения:
#   cp .env.template .env
# Файл .env в репозиторий не попадает.
#
# Значения ниже рассчитаны на запуск через Docker Compose: db — это имя
# сервиса из docker-compose.yaml, внутри сети Docker оно работает как адрес.
# Как запустить без Docker, написано в README.
#
# Этот же файл читает сам docker-compose: из него он берёт DB_NAME,
# DB_USER и DB_PASSWORD, чтобы создать базу с такими параметрами.

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=Europe/Vienna

# --- База данных ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ads_board
DB_USER=ads_board
DB_PASSWORD=ads_board_local_password
DB_HOST=db
DB_PORT=5432

# --- CORS ---
# Домены фронтенда через запятую
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=1

# --- Почта ---
# console — письма печатаются в лог контейнера, почтовый сервер не нужен.
# Режим по умолчанию: проект запускается у любого проверяющего сразу.
# Как достать ссылку сброса пароля из лога — написано в README.
#
# smtp — реальная отправка. Тогда поменяйте режим ниже и раскомментируйте
# остальные строки. EMAIL_HOST_PASSWORD — это ПАРОЛЬ ПРИЛОЖЕНИЯ, а не
# обычный пароль от почты: при включённой двухфакторной аутентификации
# обычным паролем в SMTP войти нельзя. Создаётся в настройках
# безопасности почтового аккаунта и отзывается отдельно от основного.
EMAIL_MODE=console
DEFAULT_FROM_EMAIL=noreply@ads-board.local
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Шаблон ссылки для сброса пароля: сюда подставляются uid и token
PASSWORD_RESET_CONFIRM_URL=password/reset/confirm/{uid}/{token}
